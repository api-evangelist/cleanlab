  "info": {
    "_postman_id": "1db91e6a-852d-4c18-8ecb-c3f935d07d69",
    "name": "Cleanlab Codex Studio API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Specification of the Cleanlab data-and-AI trust platform APIs. Covers the Trustworthy Language Model (TLM) OpenAI-compatible Chat Completions endpoint, the Codex / Cleanlab AI Platform project validation (guardrail and remediation) endpoint, and the Cleanlab Studio deployed-model REST inference endpoint. All endpoints are HTTPS REST and authenticate with a Cleanlab API key (or project access key) supplied as a Bearer token.\n\nContact Support:\n Name: Cleanlab Support\n Email: support@cleanlab.ai",
      "type": "text/plain"
    }
  }
